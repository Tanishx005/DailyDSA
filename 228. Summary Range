class Solution {
    public List<String> summaryRanges(int[] nums) {

        List<String> ans = new ArrayList<>();

        int i = 0;

        while (i < nums.length) {

            int start = nums[i];

            // Move while numbers are consecutive . jab num and uske bagal wala equall ho jaye toh move.
            while (i + 1 < nums.length && nums[i + 1] == nums[i] + 1) {
                i++;
            }

            int end = nums[i];

            // Single number ayega isme
            if (start == end) {
                ans.add(start + "");
            }
            // Range (kaha se kaha tak)
            else {
                ans.add(start + "->" + end);
            }

            i++;
        }

        return ans;
    }
}