
import java.util.Arrays;

class Solution {
    public String[] createGrid(int m, int n) {
        char[][] grid = new char[m][n];

        // sare cells ko block krdiya phele.
        for (int i = 0; i < m; i++) {
            Arrays.fill(grid[i], '#');
        }

        // first row mein . bhar diya
        Arrays.fill(grid[0], '.');

        // and last column mein bhi
        for (int i = 0; i < m; i++) {
            grid[i][n - 1] = '.';
        }

        // convert krdo string mein
        String[] result = new String[m];

        for (int i = 0; i < m; i++) {
            result[i] = new String(grid[i]);
        }

        return result;
    }
}

