class Solution {
    public int timeRequiredToBuy(int[] t, int k) {

        Queue<Integer> q1 = new LinkedList<>();
        int time = 0;
        for(int i = 0 ; i<t.length;i++){
            q1.add(i);
        }
        while(t[k]>0){
            int person = q1.poll();   // get the person at the front.
            t[person]--;
            time+=1;
            if(t[person]>0){
                q1.add(person);
                // add their index back to queue
            }     
        }
        return time;
    }
}
