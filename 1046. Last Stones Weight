class Solution {
    public int lastStoneWeight(int[] stones) {

        PriorityQueue<Integer> pq = new PriorityQueue<>(Collections.reverseOrder());  
        for(int i = 0 ; i<stones.length;i++){
            pq.add(stones[i]);
        }

        while(pq.size()>=2){
            int x = pq.poll(); // 1 st heaviest 
            int y = pq.poll(); // 2 nd heaviest
        
            if(y!=x){
                pq.add(x-y); // weights different -> add their difference.
            }
        }

        if(pq.isEmpty()){
            return 0;
        }
        return pq.poll();
        
    }
}