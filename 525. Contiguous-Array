class Solution {
    public int findMaxLength(int[] nums) {

        int zeros = 0;
        int ones = 0;
        int res = 0;
        
        HashMap<Integer,Integer> map = new HashMap<>();
        map.put(0,-1); 

        for(int i = 0 ; i<nums.length ; i++){
            if(nums[i]==0){
                zeros++;
            }
            else{
                ones++;
            }
            int diff = zeros-ones;
            if(map.containsKey(diff)){
                int oldIndex = map.get(diff);
                int length = i - oldIndex;
                res = Math.max(res, length);
            }
            else{
                map.put(diff,i);
            }
        }

        return res;    

        }
  
    }

