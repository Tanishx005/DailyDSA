class Solution {
    public int longestOnes(int[] nums, int k) {
        
        int l = 0; int maxl = 0 ; int zeros = 0; 
        for(int r = 0 ; r<nums.length;r++){
            if(nums[r]==0){
                zeros++;                                // for calculating no of 0's
            }
            while(zeros>k){
                if(nums[l]==0){                         // shrinking of window 
                    zeros--;                            // if no of 0's is more than k. 0's --
                                                        
                }
                l++;                                    // for finding new window
            }

            maxl = Math.max(maxl,r-l+1);
        }
        return maxl;

    }
}