class Solution {
    public boolean canAliceWin(int n) {
        
        int x = 10; // stones to remove (initially 10)
        boolean aliceturn = true;
        while(n>=x){
            n -= x;
            aliceturn = !aliceturn; // pass the turn to bob
            x--;
        }
        return !aliceturn;

    }
}