class Solution {
    public int countCommas(int n) {

        int total = 0;
        long start = 1000;
        long commas = 1;

        while (start <= n) {

            long end = start * 1000 - 1;

            if (end > n) {
                end = n;
            }

            long count = end - start + 1;

            total += count * commas;

            start = start * 1000;
            commas++;
        }

        return total;
    }
}

