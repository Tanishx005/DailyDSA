import java.util.Arrays;

class Solution {
    public int minMeetingRooms(int[] start, int[] end) {
        
        Arrays.sort(start);
        Arrays.sort(end);
        
        int i = 0; int j = 0; int res = 0; int rooms = 0;
    
        while(i<start.length){
            
            if(start[i]<end[j]){
                rooms++;
                i++;
                res=Math.max(res,rooms);
            }
            else{
                rooms--;
                j++;
            }
        }
        return res;
    }
}
