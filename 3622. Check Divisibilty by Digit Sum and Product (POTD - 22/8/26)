class Solution {
    public boolean checkDivisibility(int n) {

        int sum = 0; int temp = n;
        int product = 1;
        int a = 0;

        while (temp > 0) {
            a = temp % 10;
            sum = sum + a;
            product = product * a;
            temp = temp / 10;
        }

        int sum2 = sum + product;
        if (n % sum2 == 0) {
            return true;
        } else {
            return false;
        }

    }
}