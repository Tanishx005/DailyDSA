class Solution {
    public boolean isPerfectSquare(int num) {

        long st = 0;
        long en = num;

        while (st <= en) {
            long mid = st + (en - st) / 2;

            if (mid * mid == num) {
                return true;
            }
            else if (mid * mid > num) {
                en = mid - 1;
            }
            else {
                st = mid + 1;
            }
        }

        return false;
    }
}