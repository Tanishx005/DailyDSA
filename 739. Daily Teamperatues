import java.util.Stack;

class Solution {
    public int[] dailyTemperatures(int[] t) {

        int n = t.length;
        int []ans = new int[n];
        Stack <Integer> st = new Stack<>();
        for(int i = 0 ; i<n ; i++){
            while(!st.isEmpty() && t[i]>t[st.peek()]){
                int prev_indx = st.pop();
                ans [prev_indx] = i - prev_indx; 
                
            }
        st.push(i);

        }
        return ans;
        
    }
}