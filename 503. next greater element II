class Solution {
    public int[] nextGreaterElements(int[] nums) {

        int n = nums.length;

        // Initialize result array with -1
        int[] res = new int[n];

        for (int i = 0; i < n; i++) {
            res[i] = -1;
        }

        Stack<Integer> st = new Stack<>();

        // Traverse twice to handle circular array
        for (int i = 0; i < 2 * n; i++) {

            int currIndex = i % n;

            // Find next greater element
            while (!st.isEmpty() && nums[currIndex] > nums[st.peek()]) {

                res[st.peek()] = nums[currIndex];
                st.pop();
            }

            // Push only during first traversal
            if (i < n) {
                st.push(currIndex);
            }
        }

        return res;
    }
}