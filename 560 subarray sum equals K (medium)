class Solution {
    public int subarraySum(int[] nums, int k) {

        HashMap <Integer,Integer> map = new HashMap <>();
        int sum = 0; int res = 0;
        map.put(0,1);

        for(int i : nums){
            sum += i;
            int q = sum-k;
            int f = map.getOrDefault(q,0);
            res += f;
            map.put(sum, map.getOrDefault(sum, 0) + 1);
        }
        return res;
        
    }
}