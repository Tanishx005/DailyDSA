class Solution {
    public int threeSumClosest(int[] nums, int t) {

        Arrays.sort(nums);

        int n = nums.length;
        int bestSum = nums[0] + nums[1] + nums[2];

        for (int i = 0; i < n - 2; i++) {

            int l = i + 1;
            int r = n - 1;

            while (l < r) {

                int currSum = nums[i] + nums[l] + nums[r];

                // Check if current sum is closer
                if (Math.abs(currSum - t) < Math.abs(bestSum - t)) {
                    bestSum = currSum;
                }

                // Move pointers
                if (currSum > t) {
                    r--;
                } 
                else if (currSum < t) {
                    l++;
                } 
                else {
                    return currSum;
                }
            }
        }

        return bestSum;
    }
}