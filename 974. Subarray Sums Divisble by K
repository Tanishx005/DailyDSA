class Solution {
    public int subarraysDivByK(int[] nums, int k) {

        HashMap<Integer, Integer> map = new HashMap<>();

        int sum = 0;
        int res = 0;
        int rem = 0;
        map.put(0, 1);

        for (int i = 0; i < nums.length; i++) {
            sum = nums[i] + sum;
            rem = sum % k;
            if(rem<0){
                rem = rem +k;
            }
            if (map.containsKey(rem)) {
                res += map.get(rem);
            }

            map.put(rem, map.getOrDefault(rem,0) + 1);

        }

        return res;

    }
}

