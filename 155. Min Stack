
class MinStack {
    Node top;

    class Node {
        int val;
        int min;
        Node next;

        Node(int val, int min) {
            this.val = val;
            this.min = min;
            this.next = null;
        }
    }

    public MinStack() {
        top = null;
    }

    public void push(int val) {
        if (top == null) {
            top = new Node(val, val);
        } else {
            Node n = new Node(val, Math.min(val, top.min));
            n.next = top;
            top = n;
        }
    }

    public void pop() {
        top = top.next;
    }

    public int top() {
        return top.val;
    }

    public int getMin() {
        return top.min;
    }
}
